---
import PluginLayout from '../../layouts/PluginLayout.astro';
---
<PluginLayout title="SynchroCode — Login" theme="dark">
  <div class="bg-[var(--plugin-bg)] flex-1 flex flex-col p-6 overflow-y-auto custom-scrollbar">
    <div class="flex flex-col items-center mb-8 pt-4">
      <div class="w-10 h-10 bg-[#2e75b8] rounded-lg flex items-center justify-center mb-4 shadow-lg shadow-blue-900/30 p-1.5">
        <img src="/Logo_white.svg" alt="SynchroCode" class="w-full h-full object-contain" />
      </div>
      <h2 class="text-xl font-semibold text-zinc-100">Inicia sesión</h2>
      <p class="text-xs text-zinc-400 mt-1">Sincroniza tu código en tiempo real</p>
    </div>

    <form class="space-y-4" id="loginForm">
      <div class="space-y-2">
        <label class="text-xs font-medium text-zinc-400 ml-1">Correo electrónico</label>
        <input type="email" id="email" placeholder="tu@empresa.com"
          required
          autocomplete="email"
          class="w-full bg-zinc-900 border border-zinc-700 text-zinc-100 text-sm rounded-md px-3 py-2.5 focus:outline-none focus:ring-1 focus:ring-[#2e75b8] placeholder:text-zinc-600" />
      </div>
      <div class="space-y-2">
        <div class="flex justify-between items-center">
          <label class="text-xs font-medium text-zinc-400 ml-1">Contraseña</label>
          <button type="button" onclick="window.__navigate('recuperar-contrasena')"
            class="text-[11px] text-[#2e75b8] hover:underline font-medium bg-transparent border-0 cursor-pointer">
            ¿Olvidaste tu clave?
          </button>
        </div>
        <div class="relative">
          <input type="password" id="password" placeholder="••••••••"
            required
            autocomplete="current-password"
            class="w-full bg-zinc-900 border border-zinc-700 text-zinc-100 text-sm rounded-md px-3 py-2.5 pr-10 focus:outline-none focus:ring-1 focus:ring-[#2e75b8] placeholder:text-zinc-600" />
          <button type="button" id="togglePwd" class="absolute right-3 top-1/2 -translate-y-1/2 text-zinc-500 hover:text-zinc-300">
            <svg id="eyeIcon" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/>
              <circle cx="12" cy="12" r="3"/>
            </svg>
          </button>
        </div>
      </div>
      <div id="loginError" class="hidden text-xs text-red-400 bg-red-900/20 border border-red-800/50 rounded px-3 py-2"></div>
      <button type="submit" id="loginSubmitBtn"
        class="w-full bg-[#2e75b8] hover:bg-[#2563a8] text-white font-medium py-2.5 rounded-md transition-colors text-sm shadow-sm">
        Ingresar
      </button>
    </form>

  </div>

  <script>
    import { initLogin } from '../../scripts/login';

    const vscode = window.__vscode || null;

    initLogin({
      formId: 'loginForm',
      emailId: 'email',
      passwordId: 'password',
      togglePasswordButtonId: 'togglePwd',
      eyeIconId: 'eyeIcon',
      errorId: 'loginError',
      submitButtonId: 'loginSubmitBtn',
      githubButtonId: 'githubBtn',
      onLoginSuccess: () => {
        if (typeof window.__navigate === 'function') {
          window.__navigate('dashboard');
          return;
        }
        window.location.href = '/plugin/dashboard';
      },
      openExternal: (url) => {
        if (vscode) {
          vscode.postMessage({ command: 'openExternal', url });
          return;
        }
        window.location.href = url;
      },
    });
  </script>
</PluginLayout>
